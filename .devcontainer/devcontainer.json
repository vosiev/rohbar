{
  "name": "RohBar Development",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu",
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "26"
    },
    "ghcr.io/devcontainers/features/rust:1": {
      "version": "stable"
    },
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {
      "moby": false,
      "dockerDashComposeVersion": "latest"
    }
  },
  "forwardPorts": [3000, 8080, 5432, 6379],
  "portsAttributes": {
    "3000": { "label": "RohBar Web", "onAutoForward": "openBrowser" },
    "8080": { "label": "RohBar API", "onAutoForward": "notify" },
    "5432": { "label": "RohBar PostgreSQL", "onAutoForward": "silent" },
    "6379": { "label": "RohBar Redis", "onAutoForward": "silent" }
  },
  "postCreateCommand": "npm install --global corepack@0.35.0 && corepack enable && corepack prepare pnpm@12.3.4 --activate && pnpm install --no-frozen-lockfile && cd apps/api && cargo check",
  "remoteUser": "vscode"
}
