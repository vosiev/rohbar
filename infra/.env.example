# Required
POSTGRES_PASSWORD=replace-with-a-long-random-password
FRONTEND_ORIGIN=https://rohbar.vosiev.com

# Host-only published ports. Keep these bound to loopback on shared VPS hosts.
ROHBAR_BIND_ADDRESS=127.0.0.1
ROHBAR_API_PORT=18080
ROHBAR_WEB_PORT=13000

# Bootstrap administrator. Use a unique password of at least 15 characters.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-long-random-admin-password

# Telegram: both values required for production activation. Never commit real values.
# BotFather token; setup: python3 scripts/setup-telegram.py --check-only
TELEGRAM_BOT_TOKEN=
# Random secret: 1-256 characters A-Z a-z 0-9 _ -, shared by backend and setWebhook.
TELEGRAM_WEBHOOK_SECRET=

# Free routing stack. Valhalla uses locally built OpenStreetMap Russia graph data.
VALHALLA_DATA_DIR=/opt/rohbar-routing
VALHALLA_URL=http://valhalla:8002
# Free Yandex Tiles API underlay only. Restrict this browser-visible key to rohbar.vosiev.com.
# RohBar does not use paid Yandex routing, geocoding, search, or traffic APIs.
YANDEX_TILES_API_KEY=

# Other optional integrations
AUTOMATION_SECRET=
RUST_LOG=info
